@startuml
title Cyber AI - Auth Registration Sequence

actor User
participant "AuthScreen" as UI
participant "useAuth.ts" as Auth
participant "Supabase Auth" as AuthAPI
database "Supabase DB" as DB

== Register ==
User -> UI : enter email, password, full_name
UI -> Auth : signUp(email, password, fullName)
Auth -> AuthAPI : POST /auth/v1/signup
AuthAPI --> Auth : user (unconfirmed)

alt email confirmation required
  Auth --> UI : error: check email, then sign in
  UI --> User : show confirmation prompt
  User -> UI : enter credentials again
  UI -> Auth : signIn(email, password)
  Auth -> AuthAPI : POST /auth/v1/token (password grant)
  AuthAPI --> Auth : session
else session returned immediately
  AuthAPI --> Auth : session
end

Auth -> DB : POST profile (role=user) -- on conflict PATCH
DB --> Auth : ok
Auth --> UI : session active
UI --> User : show Chat workspace

== Sign In (existing user) ==
User -> UI : enter email, password
UI -> Auth : signIn(email, password)
Auth -> AuthAPI : POST /auth/v1/token (password grant)
AuthAPI --> Auth : session
Auth -> DB : GET profiles (by id)
DB --> Auth : profile
Auth --> UI : session active
UI --> User : show Chat workspace
@enduml
