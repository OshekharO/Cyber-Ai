@startuml
title Cyber AI - Chat Message Sequence

actor User
participant "ChatWorkspace" as UI
participant "useAuth.ts" as Auth
participant "AI API" as AI
participant "Brave Search" as Brave
database "Supabase" as DB

== Send message ==
User -> UI : types message
UI -> Auth : get session
Auth --> UI : session token
UI -> AI : POST /chat (message, session)

alt primary API OK
  AI --> UI : SSE stream (tokens)
  UI --> User : stream AI reply
else primary API fails
  UI -> Brave : search query
  Brave --> UI : search results
  UI --> User : show fallback reply
end

UI -> DB : INSERT message (assistant)
DB --> UI : ok

group Admin-only
  UI -> DB : PATCH role / DELETE user
  DB --> UI : ok
end

== Sign out ==
User -> UI : clicks Sign out
UI -> Auth : signOut()
Auth -> DB : POST /auth/v1/logout
DB --> Auth : ok
Auth --> UI : session cleared
UI --> User : back to Landing
@enduml
