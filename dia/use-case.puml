@startuml
skinparam packageStyle rectangle
left to right direction

actor "User" as User <<human>>
actor "Admin" as Admin <<human>>

rectangle "User Features" {
  (Sign in) as SignIn
  (Register account) as SignUp
  (Sign out) as SignOut
  (Send chat message) as SendMsg
  (Search messages) as Search
  (Run chat command) as Command
  (Manage chat sessions) as Sessions
  (Toggle theme) as Theme
  (Browse landing page) as BrowseLanding
}

rectangle "Admin Features" {
  (View user list) as ListUsers
  (Filter / search users) as FilterUsers
  (View user stats) as Stats
  (Change user role) as ChangeRole
  (Delete user) as DeleteUser
  (View user queries) as ListQueries
  (Filter / search queries) as FilterQueries
}

' ---- User flows ----
User --> SignIn
User --> SignUp
User --> SignOut
User --> SendMsg
User --> Search
User --> Command
User --> Sessions
User --> Theme
User --> BrowseLanding

' ---- Admin flows ----
Admin --> ListUsers
Admin --> FilterUsers
Admin --> Stats
Admin --> ChangeRole
Admin --> DeleteUser
Admin --> ListQueries
Admin --> FilterQueries

' ---- Include relationships ----
ListUsers .> FilterUsers : includes
ListUsers .> Stats : includes
ListQueries .> FilterQueries : includes

@enduml
