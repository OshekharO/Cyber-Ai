@startuml
title Cyber AI - User Flow

start

:App loads;
:Restore session from localStorage;

if (Session valid?) then (no)
  :Show Landing page;
  :Click Get Started;
  :Show Auth screen;
  if (Register?) then (yes)
    :Sign up;
  else (no)
    :Sign in;
  endif
  :Sync profile (auto-create if missing);
else (yes)
endif

if (Is admin and admin view?) then (yes)
  partition "Admin dashboard" {
    :Load users;
    repeat
      :Change role or delete user;
    repeat while (more actions?) is (yes) not (no)
    :Back to chat or sign out;
  }
else (no)
  partition "Chat workspace" {
    :Show welcome modal (first time only);
    repeat
      :Type message or run command;
      :Stream AI reply (Brave fallback);
    repeat while (keep chatting?) is (yes) not (no)
    :Search, open admin, or sign out;
  }
endif

stop
@enduml
