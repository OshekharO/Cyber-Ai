@startuml
title Cyber AI — Class Diagram

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classFontName Segoe UI
skinparam defaultFontSize 12
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 100

' ══ Domain Entities ══════════════════════════════════════════════════════

class User <<Entity>> {
  - id: string
  - email: string
  - fullName: string
  - role: Role
}

class Session <<Entity>> {
  - id: string
  - name: string
  - createdAt: DateTime
  - updatedAt: DateTime
}

class Message <<Entity>> {
  - id: number
  - role: MessageRole
  - content: string
  - timestamp: DateTime
}

enum Role {
  USER
  ADMIN
}

enum MessageRole {
  USER
  ASSISTANT
}

' ══ Service Layer ════════════════════════════════════════════════════════

class AuthService <<Service>> {
  + signIn(email: string, password: string): Promise<User>
  + signUp(email: string, password: string, fullName: string): Promise<User>
  + signOut(): Promise<void>
  + refreshSession(): Promise<void>
}

class ChatService <<Service>> {
  + streamChat(messages: Message[], onToken: Callback): Promise<void>
  - callBraveAPI(messages: Message[]): Promise<string>
}

' ══ Presentation Layer (React Hooks) ═════════════════════════════════════

class useAuth <<Hook>> {
  + user: User | null
  + loading: boolean
  + signIn(email: string, password: string): Promise<void>
  + signOut(): Promise<void>
}

class useChat <<Hook>> {
  + sessions: Session[]
  + activeSession: Session
  + sendMessage(text: string): Promise<void>
  + deleteSession(id: string): void
}

' ══ Admin ════════════════════════════════════════════════════════════════

class AdminDashboard <<View>> {
  + fetchUsers(): Promise<User[]>
  + updateUserRole(userId: string, role: Role): Promise<void>
  + deleteUser(userId: string): Promise<void>
}

' ══ Relationships ════════════════════════════════════════════════════════

Session "1" *-- "0..*" Message : contains

useAuth --> AuthService : delegates
useAuth --> User : observes

useChat --> ChatService : delegates
useChat --> Session : manages

AuthService ..> User : produces
ChatService ..> Message : consumes

AdminDashboard --> User : manages
AdminDashboard ..> AuthService : uses

User ..> Role
Message ..> MessageRole

@enduml
